# deploy/compose.yml 이 읽는 키 목록. 실제 값은 서버의 deploy/.env 에만 둔다 (Git 제외).
# 비밀번호는 영문·숫자 위주로 (따옴표, $, 공백 금지).

# MySQL. 처음 볼륨을 만들 때만 적용된다. 이후 바꾸려면 README의 비밀번호 변경 절차를 따른다.
MYSQL_ROOT_PASSWORD=
# 앱 계정. root 는 쓸 수 없다.
DB_USERNAME=kdrinker
DB_PASSWORD=
# 생략하면 jdbc:mysql://mysql:3306/kdrinker
DB_URL=

# 비워 두고 첫 등록(README "OTP 첫 등록")에서 채운다.
TOTP_SECRET=

# web의 공개 HTTPS 주소 (DSM 역방향 프록시 도메인, 끝 슬래시 없음). 예: https://kdrinker.example.com
# 인스타그램(Meta)이 이 주소로 /api/v1/media/... 를 가져간다.
PUBLIC_BASE_URL=

# 아래 값은 P2/P3에서 사용한다. 지금은 비워 둔다.
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
ANTHROPIC_API_KEY=
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_USER_ID=

# 배포할 이미지 태그(커밋 SHA). GitHub Actions 배포가 매번 써 넣는다. 비워 두면 latest.
# 되돌릴 때만 이전 SHA로 직접 바꾸고 up -d (README 3장).
IMAGE_TAG=
